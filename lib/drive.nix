{ lib, wrench, ... }:
bolts: inputs:
let
  load =
    x:
    if builtins.isAttrs x then
      builtins.concatLists (lib.mapAttrsToList (_key: load) x)
    else if builtins.isList x then
      builtins.concatLists (map load x)
    else if builtins.isPath x then
      if lib.pathIsDirectory x then load (wrench.lib.collect x) else [ x ]
    else
      throw "Can not load type ${builtins.typeOf x} ${toString x}";

  modules = lib.evalModules {
    modules = load ((import bolts) wrench);
    specialArgs = { inherit wrench; };
  };

  isWrenchRepo =
    let
      normalize = p: lib.removeSuffix "/" (toString p);
      boltsDir = normalize (dirOf (normalize bolts));
      wrenchDir = normalize inputs.wrench.outPath;
    in
    boltsDir == wrenchDir || lib.hasPrefix (wrenchDir + "/") boltsDir;

  flakeContents =
    let
      inputs = modules.config.inputs // {
        wrench = {
          url = if isWrenchRepo then "../.." else "github:StijnRuts/nix-wrench";
          inputs.nixpkgs.follows = "nixpkgs";
        };
      };

      prettyIndented =
        prefix: value:
        let
          lines = lib.splitString "\n" (lib.generators.toPretty { } value);
        in
        builtins.concatStringsSep "\n" (
          lib.imap0 (i: line: if i == 0 then line else prefix + line) lines
        );
    in
    "# Autogenerated with 'nix run .#drive'\n"
    + "{\n"
    + "  inputs = " + prettyIndented "  " inputs + ";\n\n"
    + "  outputs = inputs: inputs.wrench.lib.drive ./bolts.nix inputs;\n"
    + "}";

  extra = {
    apps = wrench.lib.options."<system>" {
      inherit (modules.config) systems buildArgs;
      inherit inputs;
      transform = args: value: {
        drive = {
          type = "app";
          meta.description = "Regenerate flake.nix";
          program = "${args.pkgs.writeShellScriptBin "drive" ''
            cat > flake.nix << 'EOF'
            ${value}
            EOF
          ''}/bin/drive";
        };
      };
      value = _: flakeContents;
    };
  };
in
lib.recursiveUpdate (modules.config.outputs inputs) extra
